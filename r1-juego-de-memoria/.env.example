# Copie este archivo como .env.local y ajuste los valores si lo necesita.
# Todas tienen un valor por defecto: el juego funciona sin definir ninguna.

# Milisegundos que se muestran dos cartas distintas antes de ocultarse (RF-04).
NEXT_PUBLIC_TIEMPO_COMPARACION_MS=800

# Clave de localStorage donde se guardan los récords.
NEXT_PUBLIC_CLAVE_RECORDS=r1-memoria:records

# URL pública del sitio (para metadatos, robots.txt y sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
